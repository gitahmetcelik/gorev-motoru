<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gorevplatformu</groupId>
    <artifactId>gorev-platformu</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
        <shedlock.version>6.6.0</shedlock.version>
        <jjwt.version>0.12.6</jjwt.version>
        <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>
    </properties>

    <modules>
        <module>motor-cekirdek</module>
        <module>motor-spring-starter</module>
        <module>motor-api</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <!-- Surefire'in varsayilan include desenleri (Test*/*Test/*Tests/*TestCase)
                         bu depodaki Turkce test sinifi adlandirmasini (orn. *Testleri) yakalamiyor
                         — mvn test sessizce SIFIR test kosup "basarili" gorunuyordu, CI'da fark
                         edilmezdi. Varsayilanlarin ustune *Testleri deseni ekleniyor. -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/Test*.java</include>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                            <include>**/*TestCase.java</include>
                            <include>**/*Testleri.java</include>
                        </includes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- motor-cekirdek ve motor-spring-starter'i dis tuketicilere (webhook-platformu)
         acmak icin GitHub Packages Maven registry'sine publish edilir (bkz webhook-platformu
         Faz 5.0 karari - local .m2'ye guvenmek CI/dagitim ortaminda calismiyordu). -->
    <distributionManagement>
        <repository>
            <id>github-gorev-motoru</id>
            <name>GitHub Packages - gorev-motoru</name>
            <url>https://maven.pkg.github.com/gitahmetcelik/gorev-motoru</url>
        </repository>
    </distributionManagement>
</project>